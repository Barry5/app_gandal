# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in your real values.
#
# For production, set all variables via Vercel (web) and Render (api).
# See .env.production.example for the production template.

# API
JWT_SECRET=change-me-with-a-long-random-secret
ACCESS_CODE_PEPPER=change-me-with-another-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Pedagogical AI - Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL
# Use the PostgreSQL connection string from Supabase Project Settings > Database.
# Recommended for the app/API: transaction pooler URL with sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Local Windows/Node may reject Supabase's certificate chain depending on the machine.
# Keep this false locally only if you see SELF_SIGNED_CERT_IN_CHAIN.
DB_SSL_REJECT_UNAUTHORIZED=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Payments - CinetPay Checkout V2
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key
CINETPAY_CHANNELS=MOBILE_MONEY

# Cloudinary media
# Signed browser uploads for course videos.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-signed-upload-preset
CLOUDINARY_VIDEO_FOLDER=courses/videos
# Use "authenticated" when you want signed playback URLs instead of public delivery.
CLOUDINARY_VIDEO_DELIVERY_TYPE=upload
