# Production environment template
# Do not commit real secrets.

# API - Render
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://...
DB_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_CODE_PEPPER=replace-with-another-long-random-secret
CORS_ORIGINS=https://your-vercel-domain.vercel.app,https://your-custom-domain.com
APP_URL=https://your-vercel-domain.vercel.app
API_PUBLIC_URL=https://your-render-api.onrender.com

# Pedagogical AI
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_PRESET=replace-with-upload-preset
CLOUDINARY_VIDEO_FOLDER=courses/videos
CLOUDINARY_VIDEO_DELIVERY_TYPE=upload

# CinetPay
CINETPAY_API_KEY=replace-with-cinetpay-api-key
CINETPAY_SITE_ID=replace-with-cinetpay-site-id
CINETPAY_SECRET_KEY=replace-with-cinetpay-secret-key
CINETPAY_CHANNELS=MOBILE_MONEY

# Web - Vercel
NEXT_PUBLIC_API_URL=https://your-render-api.onrender.com/api
